{
  "UUID": "com.claudedeck.deck.plugin",
  "Name": "Claude Deck",
  "Description": "Claude Code on the Ulanzi Deck: live status pet, answer questions from the deck, and a big-screen session display.",
  "Overview": "See and control every Claude Code session from your Ulanzi Deck.",
  "Author": "Antonio González",
  "Version": "2.1.0",
  "Icon": "resources/icon.png",
  "Banner": [
    "resources/banners/banner-1.png",
    "resources/banners/banner-2.png"
  ],
  "Category": "Claude Deck",
  "CategoryIcon": "resources/category.svg",
  "CodePath": "plugin/app.js",
  "Type": "JavaScript",
  "PrivateAPI": true,
  "SupportedInMultiActions": false,
  "Actions": [
    {
      "Name": "Claude Pet",
      "Tooltip": "Live Claude Code status: coding, asking, or idle. Press to jump to the session needing you.",
      "Icon": "resources/action-claudepet.png",
      "PropertyInspectorPath": "property-inspector/claudepet.html",
      "UUID": "com.claudedeck.deck.plugin.claudepet",
      "States": [
        {
          "Name": "Claude Pet",
          "Image": "resources/action-claudepet.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Option Next",
      "Tooltip": "Cycle through the options Claude is asking about (shown on the big key).",
      "Icon": "resources/action-optnext.png",
      "UUID": "com.claudedeck.deck.plugin.optnext",
      "States": [
        {
          "Name": "Claude Option Next",
          "Image": "resources/action-optnext.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Option OK",
      "Tooltip": "Answer Claude with the option currently shown on the big key.",
      "Icon": "resources/action-optok.png",
      "UUID": "com.claudedeck.deck.plugin.optok",
      "States": [
        {
          "Name": "Claude Option OK",
          "Image": "resources/action-optok.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Screen Setup",
      "Tooltip": "Toggle Claude status on the big screen. Press = automatic (Studio restarts itself).",
      "Icon": "resources/action-screensetup.png",
      "PropertyInspectorPath": "property-inspector/screensetup.html",
      "UUID": "com.claudedeck.deck.plugin.screensetup",
      "States": [
        {
          "Name": "Claude Screen Setup",
          "Image": "resources/action-screensetup.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Session Switch",
      "Tooltip": "Cycle which Claude session the big screen shows (one way, wraps around).",
      "Icon": "resources/action-sessionswitch.png",
      "UUID": "com.claudedeck.deck.plugin.sessionswitch",
      "States": [
        {
          "Name": "Claude Session Switch",
          "Image": "resources/action-sessionswitch.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Compact",
      "Tooltip": "Compact the top Claude session's context. Press once to confirm (eyes), press again to run /compact.",
      "Icon": "resources/action-compact.png",
      "UUID": "com.claudedeck.deck.plugin.compact",
      "States": [
        {
          "Name": "Claude Compact",
          "Image": "resources/action-compact.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Session Screen",
      "Tooltip": "The big-screen display: session name, status, and the question picker. Placed on the big key by Claude Screen Setup.",
      "Icon": "resources/action-itermcycle.png",
      "PropertyInspectorPath": "property-inspector/itermcycle.html",
      "UUID": "com.claudedeck.deck.plugin.itermcycle",
      "States": [
        {
          "Name": "Claude Session Screen",
          "Image": "resources/action-itermcycle.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "Name": "Claude Clear",
      "Tooltip": "Wipe the top Claude session's conversation history. Press once to confirm (eyes), press again to run /clear.",
      "Icon": "resources/action-clear.png",
      "UUID": "com.claudedeck.deck.plugin.clear",
      "States": [
        {
          "Name": "Claude Clear",
          "Image": "resources/action-clear.png"
        }
      ],
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ]
    }
  ],
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Software": {
    "MinVersion": "3.0.11"
  }
